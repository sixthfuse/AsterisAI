# Runtime mode: development, test, or production
ASTERIS_ENV=development
# Secrets: use real values only in a local secret store or deployment platform
OPENAI_API_KEY=replace-with-secret
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=asteris
DB_USER=replace-with-database-user
DB_PASSWORD=replace-with-secret
ASTERIS_INTERNAL_API_KEY=replace-with-at-least-24-random-characters

# Network and spend controls
ASTERIS_ALLOWED_HOSTS=127.0.0.1,localhost
ASTERIS_ALLOWED_ORIGINS=
ASTERIS_MAX_REQUEST_BYTES=65536
ASTERIS_RATE_LIMIT_PER_MINUTE=20
ASTERIS_MAX_CONCURRENT_ADVISOR_REQUESTS=4
ASTERIS_OPENAI_TIMEOUT_SECONDS=30
ASTERIS_OPENAI_MAX_RETRIES=1
ASTERIS_OPENAI_MAX_OUTPUT_TOKENS=1200
ASTERIS_DB_CONNECT_TIMEOUT_SECONDS=5
ASTERIS_LOG_LEVEL=INFO
# Student-facing tenant identity and model profile
ASTERIS_PLATFORM_NAME=Asteris
ASTERIS_INSTITUTION_NAME=BCIT
ASTERIS_AI_MODEL=gpt-5.6-sol
ASTERIS_AI_REASONING_EFFORT=medium
# Experimental /advisor-v2 language layer only; set 0 for exact Phase 2 behavior
ASTERIS_ADVISOR_V2_SOL=1
